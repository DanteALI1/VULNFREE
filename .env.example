# === Основные настройки VULNDB ===

# Секретный ключ Django (сгенерируйте уникальный для продакшена)
SECRET_KEY=change-me-to-a-long-random-string

# Режим отладки (False в продакшене)
DEBUG=True

# Разрешённые хосты через запятую (домен, localhost и IP сервера)
ALLOWED_HOSTS=localhost,127.0.0.1
# Автоматически добавить IP интерфейсов (LAN). False — только ALLOWED_HOSTS
ALLOW_LAN_HOSTS=True

# URL базы данных. Пусто = SQLite (dev). Для продакшена — PostgreSQL:
# DATABASE_URL=postgres://vulndb:vulndb@db:5432/vulndb
DATABASE_URL=

# Redis для Celery (в docker-compose хост = redis; локально = localhost)
REDIS_URL=redis://redis:6379/0
# REDIS_URL=redis://localhost:6379/0

# Пароль PostgreSQL (не хранится в модели SystemSettings)
POSTGRES_PASSWORD=vulndb

# Куки только по HTTPS (True в продакшене)
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SECURE=False

# Опциональный API-ключ NVD (можно задать и в UI)
NVD_API_KEY=

# === Почта (опционально, дублируется настройками в UI) ===
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=vulndb@localhost

# === Telegram (опционально) ===
TELEGRAM_BOT_TOKEN=
